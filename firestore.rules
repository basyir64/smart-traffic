rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // Locations — read-only for authenticated users
    match /locations/{locationId} {
      allow read: if true;
      allow write: if false;
    }

    // Period stats — read-only for authenticated users
    match /periods/{periodId} {
      allow read: if true;
      allow write: if false;
    }

    // Siasatan records — read for all, write for authenticated
    match /siasatan/{siasatanId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contributing factors — read-only
    match /factors/{factorId} {
      allow read: if true;
      allow write: if false;
    }

    // TODO: Replace with proper role-based rules when auth is added
    // Temporary fallback — remove before production
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 12);
    }
  }
}
