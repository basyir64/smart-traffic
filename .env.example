# ==========================================
# SMART TRAFFIC AI — Environment Variables
# ==========================================
# Copy this file to .env.local for local overrides.
# .env.local is ignored by git to keep credentials safe.

# --- Environment Mode ---
# Options: 'emulator' (local dev with Firebase Emulators) | 'prod' (Cloud Firestore/Auth)
VITE_APP_ENV=emulator

# --- Google Maps JavaScript API (Phase 3) ---
# Create an API Key in Google Cloud Console with "Maps JavaScript API" enabled.
# Restrict to HTTP referrers: http://localhost:*/*
VITE_GOOGLE_MAPS_API_KEY=

# --- Google Gemini API (Phase 3) ---
# Generate an API Key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# --- Firebase Configuration (Optional Overrides) ---
# Defaults in src/fb_cloud_firestore.js target 'smart-traffic-93b67'.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=smart-traffic-93b67
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
